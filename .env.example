# =============================================================================
# Shortlink Pro - template environment
# =============================================================================
# Dipakai dua hal sekaligus:
#   1. env_file container `app` dan `scheduler` (docker-compose.fulldb.yaml)
#   2. interpolasi ${...} oleh docker compose (DB_DATABASE, DB_USERNAME, ...)
#
# Untuk deploy Docker:
#   cp .env.example .env
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"   # APP_KEY
#   mkdir -p secrets
#   openssl rand -base64 24 > secrets/db_root_password.txt
#   chmod 600 secrets/db_root_password.txt
#
# Untuk pengembangan lokal (XAMPP): nilai yang berbeda hanya APP_ENV,
# APP_DEBUG, APP_URL, SESSION_SECURE_COOKIE, DB_HOST, dan DB_PASSWORD.
#
# Kata sandi root MySQL TIDAK ditaruh di sini (lihat secrets/ di atas).
# Berkas .env tidak pernah masuk image (.dockerignore) dan tidak di-commit.
# =============================================================================

# --- Compose ----------------------------------------------------------------
# Port loopback tempat nginx host meneruskan permintaan.
APP_PORT=9000
APP_IMAGE_TAG=latest
# Port loopback phpMyAdmin (profil `tools`, tidak dipakai runtime).
PMA_PORT=8081
# Jangan diturunkan di bawah 8.3.36 (patch PHP2Shell).
PHP_VERSION=8.3.36
# Zona waktu container (dibaca dari env_file oleh app & scheduler), supaya
# stempel waktu di log Apache/PHP memakai WIB, bukan UTC.
TZ=Asia/Jakarta

# --- Aplikasi ---------------------------------------------------------------
APP_NAME="Shortlink Pro"
APP_ENV=production
APP_DEBUG=false
# Wajib terisi; aplikasi menolak start bila kosong.
APP_KEY=
# Domain publik Cloudflare Tunnel, tanpa garis miring di akhir.
APP_URL=https://shortlink.example.com
# Zona waktu aplikasi (PHP & Carbon). Server/container memakai TZ di atas.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr -> log masuk ke `docker compose logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Basis data (service db pada compose) -----------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=shortlink_pro
DB_USERNAME=shortlink
# Hindari karakter "$" di sini: compose menganggapnya awal variabel.
DB_PASSWORD=ubah-kata-sandi-kuat

# --- Sesi, cache, antrian ---------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
# true = cookie hanya dikirim lewat HTTPS. Pakai false hanya untuk uji HTTP
# langsung ke 127.0.0.1:9000 tanpa nginx/Cloudflare.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- SSO Keycloak (kosongkan untuk menonaktifkan) ---------------------------
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=https://shortlink.example.com/auth/keycloak/callback

# --- Masuk dengan Google (kosongkan untuk menonaktifkan) --------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://shortlink.example.com/auth/google/callback

# --- Akun demo (WAJIB kosong di produksi) -----------------------------------
DEMO_ACCOUNT_PASSWORD=

# --- Pemendek tautan --------------------------------------------------------
PEMENDEK_QR_CACHE_SECONDS=86400
PEMENDEK_PASSWORD_MAX_ATTEMPTS=5
PEMENDEK_PASSWORD_LOCK_SECONDS=60
PEMENDEK_SAFE_BROWSING=true
# Buat di Google Cloud Console dengan Safe Browsing API aktif.
# Kosong = pemeriksaan dilewati (fail-open).
PEMENDEK_SAFE_BROWSING_KEY=
PEMENDEK_SAFE_BROWSING_TIMEOUT_SECONDS=3

# --- Email ------------------------------------------------------------------
# log = email hanya dicatat. Isi SMTP agar atur ulang kata sandi benar-benar
# mengirim email.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@shortlink.example.com"
MAIL_FROM_NAME="Shortlink Pro"
