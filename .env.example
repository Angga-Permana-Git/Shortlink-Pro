APP_NAME=Shortlink Pro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
# Wajib true di produksi yang memakai HTTPS (termasuk di balik Cloudflare Tunnel).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ==========================================================================
# SSO KEYCLOAK (OIDC)
# ==========================================================================
# SSO aktif otomatis jika KEYCLOAK_BASE_URL dan KEYCLOAK_REALM diisi.
# Jika keduanya kosong, tombol SSO disembunyikan dan login hanya via /login/local.
#
# Lihat KEYCLOAK_SETUP.md untuk panduan membuat client di konsol admin Keycloak.

# Kosongkan seluruh blok ini bila tidak memakai SSO. Contoh nilai ada di
# komentar; jangan menyalin contoh ke berkas .env produksi.
# URL server Keycloak (tanpa trailing slash, tanpa "/realms")
# Contoh: https://keycloak.internal.local
KEYCLOAK_BASE_URL=

# Nama realm Keycloak (case-sensitive)
# Contoh: internal
KEYCLOAK_REALM=

# Client ID aplikasi di Keycloak (OpenID Connect, Client authentication: ON)
# Contoh: shortlink-app
KEYCLOAK_CLIENT_ID=

# Client secret dari tab Credentials -> Client secret di Keycloak
# WAJIB RAHASIA: jangan commit / bocorkan nilai ini
KEYCLOAK_CLIENT_SECRET=

# Redirect URI aplikasi; HARUS sama persis dengan
# "Valid redirect URIs" yang didaftarkan di Keycloak (Client -> Settings)
KEYCLOAK_REDIRECT_URI=${APP_URL}/auth/keycloak/callback

# Redirect setelah logout; daftarkan juga di Keycloak sebagai
# "Valid post logout redirect URIs"
KEYCLOAK_LOGOUT_REDIRECT_URI=${APP_URL}

# ==========================================================================
# MASUK DENGAN GOOGLE (OAuth 2.0)
# ==========================================================================
# Tombol "Masuk dengan Google" hanya tampil bila CLIENT_ID dan CLIENT_SECRET
# terisi. Lihat GOOGLE_SETUP.md untuk langkah membuat OAuth Client di Google
# Cloud Console.
#
# Authorized redirect URI yang harus didaftarkan:
#   ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

# ==========================================================================
# AKUN DEMO (PENGEMBANGAN)
# ==========================================================================
# Dipakai oleh `php artisan app:create-demo-accounts` dan DatabaseSeeder.
# Kosongkan pada produksi agar kata sandi acak yang dipakai.
DEMO_ACCOUNT_PASSWORD=

# Isi true pada container Docker bila ingin menjalankan seeder demo saat start.
# Jangan aktifkan di produksi publik.
APP_SEED=false

# --- Sumber daya tambahan bila dibutuhkan di server baru ---
# Endpoint discovery OIDC (hanya info): "${KEYCLOAK_BASE_URL}/realms/${KEYCLOAK_REALM}/.well-known/openid-configuration"
# Claim yang dipakai aplikasi: sub, preferred_username, name, email
# Pastikan scope openid, profile, email aktif di client Keycloak.
QUEUE_CONNECTION=database

# ==========================================================================
# PEMENDEK TAUTAN
# ==========================================================================
# Lama cache berkas QR (detik). Default 86400 (1 hari).
PEMENDEK_QR_CACHE_SECONDS=86400
# Batas percobaan kata sandi tautan sebelum dikunci sementara.
PEMENDEK_PASSWORD_MAX_ATTEMPTS=5
PEMENDEK_PASSWORD_LOCK_SECONDS=60
# Pemeriksaan tautan tujuan ke Google Safe Browsing sebelum disimpan.
# Biarkan kunci kosong untuk melewati pemeriksaan (pengembangan lokal).
# Buat kunci di Google Cloud Console dengan "Safe Browsing API" diaktifkan.
PEMENDEK_SAFE_BROWSING=true
PEMENDEK_SAFE_BROWSING_KEY=
PEMENDEK_SAFE_BROWSING_TIMEOUT_SECONDS=3

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Email atur ulang kata sandi memakai pengaturan MAIL_* di atas. Selama
# MAIL_MAILER=log, email tidak benar-benar terkirim: isinya masuk ke
# storage/logs/laravel.log dan tautan atur ulang juga ditampilkan di layar
# halaman lupa kata sandi supaya alurnya tetap bisa diuji.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
