APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ==========================================================================
# SSO KEYCLOAK (OIDC)
# ==========================================================================
# SSO aktif otomatis jika KEYCLOAK_BASE_URL dan KEYCLOAK_REALM diisi.
# Jika keduanya kosong, tombol SSO disembunyikan dan login hanya via /login/local.
#
# Lihat KEYCLOAK_SETUP.md untuk panduan membuat client di konsol admin Keycloak.

# URL server Keycloak (tanpa trailing slash, tanpa "/realms")
# Contoh: https://keycloak.internal.local
KEYCLOAK_BASE_URL=https://keycloak.internal.local

# Nama realm Keycloak (case-sensitive)
# Contoh: internal
KEYCLOAK_REALM=internal

# Client ID aplikasi di Keycloak (OpenID Connect, Client authentication: ON)
# Contoh: shortlink-app
KEYCLOAK_CLIENT_ID=shortlink-app

# Client secret dari tab Credentials -> Client secret di Keycloak
# WAJIB RAHASIA: jangan commit / bocorkan nilai ini
# Contoh: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KEYCLOAK_CLIENT_SECRET=change-this-secret

# Redirect URI aplikasi; HARUS sama persis dengan
# "Valid redirect URIs" yang didaftarkan di Keycloak (Client -> Settings)
KEYCLOAK_REDIRECT_URI=${APP_URL}/auth/keycloak/callback

# Redirect setelah logout; daftarkan juga di Keycloak sebagai
# "Valid post logout redirect URIs"
KEYCLOAK_LOGOUT_REDIRECT_URI=${APP_URL}

# --- Sumber daya tambahan bila dibutuhkan di server baru ---
# Endpoint discovery OIDC (hanya info): "${KEYCLOAK_BASE_URL}/realms/${KEYCLOAK_REALM}/.well-known/openid-configuration"
# Claim yang dipakai aplikasi: sub, preferred_username, name, email
# Pastikan scope openid, profile, email aktif di client Keycloak.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
